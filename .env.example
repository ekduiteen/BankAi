# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bankai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bankai

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=bank-documents

# Security
JWT_SECRET=your-super-secret-key-change-it
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM Config
LLM_PROVIDER=ollama # or openai, vllm
LLM_MODEL=llama3
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=not-needed-for-ollama

# Embedding Config
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Initial Super Admin
SUPER_ADMIN_EMAIL=admin@bankai.local
SUPER_ADMIN_PASSWORD=admin-secure-password
